{
  "name": "openboard-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "triggers": { "crons": ["0 3 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openboard",
      "database_id": "cab2cd67-509c-427f-8880-cd022a5cefb8"
    }
  ],
  "vars": {
    "FRONTEND_ORIGIN": "https://openboard.openlybuilt.com"
  },
  "secrets": {
    "required": ["CLERK_PUBLISHABLE_KEY", "CLERK_SECRET_KEY"]
  }
}
