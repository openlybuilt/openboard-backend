{
  "name": "openboard-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [{ "binding": "DB", "database_name": "whiteboard", "database_id": "00000000-0000-0000-0000-000000000000" }],
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": { "FRONTEND_ORIGIN": "http://127.0.0.1:4180" }
}
